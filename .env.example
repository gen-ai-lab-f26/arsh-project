# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# Never commit your real .env file.

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# SEC asks automated clients to name themselves and give a contact email.
# Needed to look an issuer up by ticker. A CIK works without it.
SEC_USER_AGENT=PitchCheck your-email@example.com
